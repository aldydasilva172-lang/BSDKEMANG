/* =====================================================
   ENTER QTY
===================================================== */

$("qty")
  .addEventListener(
    "keydown",
    e => {

      if(e.key === "Enter"){

        e.preventDefault();

        saveInventory();

      }

    }
  );


/* =====================================================
   CLOSE SUGGESTIONS
===================================================== */

document.addEventListener(
  "click",
  e => {

    if(
      !e.target.closest(
        ".inventory-input-group"
      )
    ){

      $("suggestions")
        .style
        .display = "none";

    }

  }
);


/* =====================================================
   PREVENT ACCIDENTAL FORM SUBMISSION
===================================================== */

document.addEventListener(
  "keydown",
  e => {

    if(
      e.key === "Escape"
    ){

      document
        .querySelectorAll(".modal.show")
        .forEach(modal => {

          modal.classList.remove(
            "show"
          );

        });

    }

  }
);


/* =====================================================
   INITIAL
===================================================== */

console.log(
  "THE BUTCHER Inventory System ready."
);

</script>

</body>
</html>
