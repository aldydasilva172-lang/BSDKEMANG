   LOGIN
===================================================== */

window.login =
async function(){

  const identity =
    $("loginIdentity")
      .value
      .trim()
      .toLowerCase();

  const password =
    $("loginPassword").value;

  const message =
    $("loginMessage");

  const button =
    $("loginButton");


  message.className =
    "message";

  message.textContent =
    "";


  if(!identity || !password){

    message.classList.add("error");

    message.textContent =
      "Username/email dan password wajib diisi.";

    return;

  }


  button.disabled = true;

  button.textContent =
    "LOGIN...";


  try{

    let email = identity;


    /*
      Kalau login menggunakan username,
      cari email melalui collection usernames.
    */

    if(!identity.includes("@")){

      const usernameRef =
        doc(
          db,
          "usernames",
          identity
        );

      const usernameSnap =
        await getDoc(usernameRef);


      if(!usernameSnap.exists()){

        throw new Error(
          "Username tidak ditemukan."
        );

      }


      const usernameData =
        usernameSnap.data();


      const userRef =
        doc(
          db,
          "users",
          usernameData.uid
        );

      const userSnap =
        await getDoc(userRef);


      if(!userSnap.exists()){

        throw new Error(
          "Data user tidak ditemukan."
        );

      }


      email =
        userSnap.data().email;

    }


    const credential =
      await signInWithEmailAndPassword(
        auth,
        email,
        password
      );


    const user =
      credential.user;


    await user.reload();


    if(!user.emailVerified){

      await signOut(auth);

      message.classList.add("error");

      message.textContent =
        "Email belum diverifikasi. Cek inbox email Anda.";

      return;

    }


    const profileSnap =
      await getDoc(
        doc(
          db,
          "users",
          user.uid
        )
      );


    if(!profileSnap.exists()){

      await signOut(auth);

      throw new Error(
        "Profil user tidak ditemukan."
      );

    }


    const profile =
      profileSnap.data();


    if(profile.status !== "approved"){

      await signOut(auth);

      message.classList.add("error");

      message.textContent =
        "Akun belum disetujui admin.";

      return;

    }


    currentUser =
      user;

    currentProfile =
      profile;


    showDashboard();


  }
  catch(error){

    console.error(error);

    message.classList.add("error");

    message.textContent =
      firebaseErrorMessage(error);

  }
  finally{

    button.disabled = false;

    button.textContent =
      "LOGIN";

  }

};


