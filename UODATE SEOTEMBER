<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>THE BUTCHER</title>

<style>

:root{
  --orange:#ff7a00;
  --orange2:#ffb347;
  --red:#ff3b30;
  --green:#35e889;
  --blue:#4b91ff;

  --bg:#08090c;
  --bg2:#101217;

  --card:rgba(255,255,255,.065);
  --card2:rgba(255,255,255,.035);

  --border:rgba(255,255,255,.11);

  --text:#ffffff;
  --muted:#9ca3af;

  --shadow:
    0 25px 80px rgba(0,0,0,.45);

  --radius:24px;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html,
body{
  width:100%;
  min-height:100%;
}

body{
  background:
    radial-gradient(
      circle at 15% 20%,
      rgba(255,122,0,.10),
      transparent 30%
    ),
    radial-gradient(
      circle at 90% 80%,
      rgba(75,145,255,.08),
      transparent 30%
    ),
    var(--bg);

  color:var(--text);

  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  overflow-x:hidden;
}

/* =========================
   BACKGROUND
========================= */

body::before{
  content:"";
  position:fixed;
  inset:0;

  pointer-events:none;

  background:
    linear-gradient(
      120deg,
      transparent 0%,
      rgba(255,255,255,.018) 50%,
      transparent 100%
    );

  z-index:-1;
}

/* =========================
   GENERAL
========================= */

button,
input{
  font:inherit;
}

button{
  cursor:pointer;
}

.hidden{
  display:none !important;
}

/* =========================
   LOGIN
========================= */

.page{
  width:100%;
  min-height:100vh;
}

#loginPage{
  min-height:100vh;

  display:flex;
  align-items:center;
  justify-content:center;

  padding:24px;
}

.login-card{
  width:100%;
  max-width:430px;

  padding:38px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.08),
      rgba(255,255,255,.025)
    );

  border:1px solid var(--border);

  border-radius:28px;

  box-shadow:var(--shadow);

  backdrop-filter:blur(22px);
  -webkit-backdrop-filter:blur(22px);

  animation:cardIn .5s ease;
}

@keyframes cardIn{
  from{
    opacity:0;
    transform:translateY(20px) scale(.98);
  }

  to{
    opacity:1;
    transform:none;
  }
}

.brand{
  text-align:center;
  margin-bottom:32px;
}

.brand-logo{
  width:78px;
  height:78px;

  margin:0 auto 16px;

  border-radius:22px;

  display:flex;
  align-items:center;
  justify-content:center;

  background:
    linear-gradient(
      145deg,
      var(--orange),
      #ff4d00
    );

  box-shadow:
    0 15px 40px rgba(255,122,0,.25);
}

.brand-logo span{
  font-size:28px;
  font-weight:900;
  letter-spacing:-2px;
}

.brand h1{
  font-size:27px;
  font-weight:900;
  letter-spacing:2px;
}

.brand p{
  margin-top:7px;
  color:var(--muted);
  font-size:13px;
}

.input-group{
  margin-bottom:16px;
}

.input-group label{
  display:block;
  margin-bottom:8px;

  font-size:12px;
  font-weight:700;

  color:#c9cdd4;
}

.input-wrap{
  position:relative;
}

.input{
  width:100%;

  height:50px;

  padding:0 15px;

  border-radius:14px;

  border:1px solid var(--border);

  background:rgba(0,0,0,.25);

  color:#fff;

  outline:none;

  transition:.2s;
}

.input:focus{
  border-color:rgba(255,122,0,.7);

  box-shadow:
    0 0 0 3px rgba(255,122,0,.09);
}

.btn{
  width:100%;

  min-height:50px;

  border:0;

  border-radius:14px;

  font-weight:800;

  transition:
    transform .18s,
    box-shadow .18s,
    opacity .18s;
}

.btn:hover{
  transform:translateY(-1px);
}

.btn:active{
  transform:translateY(1px);
}

.btn-primary{
  color:#fff;

  background:
    linear-gradient(
      135deg,
      var(--orange),
      #ff4d00
    );

  box-shadow:
    0 12px 28px rgba(255,122,0,.18);
}

.btn-secondary{
  color:#fff;

  background:rgba(255,255,255,.07);

  border:1px solid var(--border);
}

.btn-danger{
  background:
    linear-gradient(
      135deg,
      #ff453a,
      #c91f18
    );

  color:#fff;
}

.login-actions{
  margin-top:18px;

  display:flex;
  justify-content:space-between;

  gap:12px;
}

.text-button{
  background:none;
  border:0;

  color:#ff9b3d;

  font-size:12px;
  font-weight:700;
}

.text-button:hover{
  color:#ffc078;
}

.message{
  min-height:20px;

  margin-top:14px;

  font-size:12px;

  text-align:center;

  color:var(--muted);
}

.message.error{
  color:#ff6b61;
}

.message.success{
  color:#52e99a;
}

/* =========================
   DASHBOARD
========================= */

#dashboard{
  min-height:100vh;
  padding:24px;
}

.dashboard-layout{
  width:100%;
  max-width:1450px;

  min-height:calc(100vh - 48px);

  margin:0 auto;

  display:grid;

  grid-template-columns:
    minmax(0,1fr)
    minmax(280px,350px);

  gap:22px;

  align-items:stretch;
}

/* LEFT SIDE */

.dashboard-main{
  min-width:0;

  display:flex;
  flex-direction:column;

  padding:26px;

  border-radius:28px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.055),
      rgba(255,255,255,.018)
    );

  border:1px solid var(--border);

  box-shadow:var(--shadow);

  position:relative;
  overflow:hidden;
}

.dashboard-main::after{
  content:"";

  position:absolute;

  width:300px;
  height:300px;

  right:-120px;
  bottom:-150px;

  border-radius:50%;

  background:
    radial-gradient(
      circle,
      rgba(255,122,0,.15),
      transparent 70%
    );

  pointer-events:none;
}

/* TOPBAR */

.topbar{
  width:100%;

  display:flex;

  align-items:center;

  justify-content:space-between;

  gap:15px;

  margin-bottom:45px;

  position:relative;
  z-index:2;
}

.top-brand{
  display:flex;
  align-items:center;
  gap:12px;
}

.top-brand-icon{
  width:43px;
  height:43px;

  border-radius:13px;

  display:flex;
  align-items:center;
  justify-content:center;

  font-weight:900;

  background:
    linear-gradient(
      135deg,
      var(--orange),
      #ff4b00
    );

  box-shadow:
    0 8px 22px rgba(255,122,0,.18);
}

.top-brand-text{
  line-height:1.1;
}

.top-brand-text strong{
  display:block;

  font-size:15px;
  letter-spacing:1px;
}

.top-brand-text span{
  display:block;

  margin-top:4px;

  color:#858b96;

  font-size:10px;

  letter-spacing:1px;
}

.user-area{
  display:flex;
  align-items:center;
  gap:9px;
}

.avatar{
  width:38px;
  height:38px;

  border-radius:50%;

  display:flex;
  align-items:center;
  justify-content:center;

  background:
    linear-gradient(
      135deg,
      #343840,
      #181a20
    );

  border:1px solid var(--border);

  font-size:12px;
  font-weight:900;
}

.user-name{
  max-width:130px;

  overflow:hidden;
  white-space:nowrap;
  text-overflow:ellipsis;

  font-size:12px;
  font-weight:700;
}

.icon-button{
  width:38px;
  height:38px;

  border-radius:12px;

  border:1px solid var(--border);

  background:rgba(255,255,255,.045);

  color:#fff;

  display:flex;
  align-items:center;
  justify-content:center;

  font-size:16px;

  transition:.2s;
}

.icon-button:hover{
  background:rgba(255,255,255,.09);
}

/* WELCOME */

.welcome-block{
  position:relative;
  z-index:2;

  margin-top:auto;
  margin-bottom:auto;

  max-width:760px;
}

.welcome-small{
  color:var(--orange);

  font-size:12px;
  font-weight:800;

  letter-spacing:2px;

  text-transform:uppercase;

  margin-bottom:12px;
}

.welcome-title{
  font-size:
    clamp(42px,6vw,82px);

  line-height:.95;

  font-weight:950;

  letter-spacing:-4px;
}

.welcome-title span{
  background:
    linear-gradient(
      135deg,
      #fff,
      var(--orange2)
    );

  -webkit-background-clip:text;
  background-clip:text;

  color:transparent;
}

.welcome-sub{
  margin-top:20px;

  max-width:650px;

  color:#8f96a2;

  font-size:14px;

  line-height:1.7;
}

.system-status{
  display:inline-flex;

  align-items:center;
  gap:8px;

  margin-top:25px;

  padding:9px 13px;

  border-radius:999px;

  background:rgba(53,232,137,.06);

  border:1px solid rgba(53,232,137,.15);

  color:#71efa9;

  font-size:11px;

  font-weight:700;
}

.status-dot{
  width:7px;
  height:7px;

  border-radius:50%;

  background:var(--green);

  box-shadow:
    0 0 12px var(--green);
}

/* FOOTER */

.dashboard-footer{
  position:relative;
  z-index:2;

  display:flex;

  align-items:center;
  justify-content:space-between;

  gap:20px;

  margin-top:35px;

  padding-top:18px;

  border-top:1px solid rgba(255,255,255,.06);

  color:#666d78;

  font-size:10px;
}

/* =========================
   OPERATIONS RIGHT PANEL
========================= */

.operations-panel{
  display:flex;

  flex-direction:column;

  gap:14px;

  min-width:0;
}

.operations-heading{
  padding:5px 4px 3px;

  display:flex;

  justify-content:space-between;

  align-items:end;
}

.operations-heading h2{
  font-size:17px;
  font-weight:900;
}

.operations-heading span{
  color:#6d737e;

  font-size:10px;
}

.operation-card{
  flex:1;

  min-height:180px;

  padding:22px;

  border-radius:22px;

  border:1px solid var(--border);

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.065),
      rgba(255,255,255,.025)
    );

  box-shadow:
    0 18px 45px rgba(0,0,0,.25);

  position:relative;

  overflow:hidden;

  cursor:pointer;

  transition:
    transform .2s,
    border-color .2s,
    background .2s;
}

.operation-card:hover{
  transform:translateX(-4px);

  border-color:
    rgba(255,122,0,.4);

  background:
    linear-gradient(
      145deg,
      rgba(255,122,0,.10),
      rgba(255,255,255,.035)
    );
}

.operation-card::after{
  content:"";

  position:absolute;

  width:170px;
  height:170px;

  right:-70px;
  bottom:-80px;

  border-radius:50%;

  background:
    radial-gradient(
      circle,
      rgba(255,122,0,.18),
      transparent 70%
    );
}

.operation-icon{
  width:55px;
  height:55px;

  border-radius:17px;

  display:flex;
  align-items:center;
  justify-content:center;

  margin-bottom:18px;

  font-size:25px;

  background:
    rgba(255,122,0,.10);

  border:
    1px solid rgba(255,122,0,.16);
}

.operation-card.opname .operation-icon{
  background:
    rgba(75,145,255,.10);

  border-color:
    rgba(75,145,255,.17);
}

.operation-title{
  font-size:18px;

  font-weight:900;

  letter-spacing:.2px;
}

.operation-desc{
  margin-top:7px;

  color:#777f8c;

  font-size:11px;

  line-height:1.5;

  max-width:220px;
}

.operation-arrow{
  position:absolute;

  right:20px;
  top:20px;

  width:30px;
  height:30px;

  border-radius:10px;

  display:flex;
  align-items:center;
  justify-content:center;

  color:#aaa;

  background:rgba(255,255,255,.04);

  font-size:14px;
}

/* =========================
   INVENTORY PAGE
========================= */

#inventoryPage{
  position:fixed;

  inset:0;

  z-index:100;

  display:none;

  min-height:100vh;

  padding:24px;

  overflow:auto;

  background:
    radial-gradient(
      circle at 50% 30%,
      rgba(255,122,0,.09),
      transparent 35%
    ),
    rgba(8,9,12,.97);

  backdrop-filter:blur(15px);
  -webkit-backdrop-filter:blur(15px);
}

#inventoryPage.show{
  display:flex;

  align-items:center;
  justify-content:center;
}

.inventory-center{
  width:100%;

  max-width:560px;

  margin:auto;

  animation:
    inventoryIn .35s ease;
}

@keyframes inventoryIn{
  from{
    opacity:0;
    transform:
      translateY(18px)
      scale(.97);
  }

  to{
    opacity:1;
    transform:none;
  }
}

.inventory-top{
  display:flex;

  align-items:center;
  justify-content:space-between;

  gap:12px;

  margin-bottom:18px;
}

.inventory-brand{
  display:flex;
  align-items:center;
  gap:10px;
}

.inventory-logo{
  width:42px;
  height:42px;

  border-radius:13px;

  display:flex;
  align-items:center;
  justify-content:center;

  font-weight:900;

  background:
    linear-gradient(
      135deg,
      var(--orange),
      #ff4b00
    );
}

.inventory-brand strong{
  display:block;

  font-size:13px;

  letter-spacing:1px;
}

.inventory-brand span{
  display:block;

  color:#777e89;

  font-size:9px;

  margin-top:3px;
}

.back-button{
  height:40px;

  padding:0 14px;

  border-radius:12px;

  border:1px solid var(--border);

  background:rgba(255,255,255,.05);

  color:#fff;

  font-size:11px;

  font-weight:800;
}

.back-button:hover{
  background:rgba(255,255,255,.09);
}

/* INVENTORY CARD */

.inventory-card{
  padding:28px;

  border-radius:28px;

  border:1px solid var(--border);

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.075),
      rgba(255,255,255,.025)
    );

  box-shadow:var(--shadow);

  position:relative;

  overflow:visible;
}

.inventory-heading{
  text-align:center;

  margin-bottom:25px;
}

.inventory-heading-icon{
  width:66px;
  height:66px;

  margin:0 auto 15px;

  border-radius:20px;

  display:flex;
  align-items:center;
  justify-content:center;

  font-size:28px;

  background:
    rgba(255,122,0,.10);

  border:
    1px solid rgba(255,122,0,.17);
}

.inventory-card.opname-card
.inventory-heading-icon{
  background:
    rgba(75,145,255,.10);
}

.inventory-heading h1{
  font-size:27px;

  font-weight:950;

  letter-spacing:-1px;
}

.inventory-heading p{
  margin-top:6px;

  color:#777e89;

  font-size:11px;
}

/* FORM */

.inventory-form{
  display:flex;

  flex-direction:column;

  gap:15px;
}

.inventory-input-group{
  position:relative;
}

.inventory-input-group label{
  display:block;

  margin-bottom:8px;

  color:#b9bec6;

  font-size:11px;

  font-weight:800;
}

.inventory-input{
  width:100%;

  height:54px;

  padding:
    0 15px;

  border-radius:15px;

  border:1px solid var(--border);

  background:
    rgba(0,0,0,.25);

  color:#fff;

  outline:none;

  font-size:15px;

  transition:.2s;
}

.inventory-input:focus{
  border-color:
    rgba(255,122,0,.7);

  box-shadow:
    0 0 0 3px
    rgba(255,122,0,.08);
}

.inventory-input::placeholder{
  color:#565d68;
}

.qty-row{
  display:grid;

  grid-template-columns:
    1fr 150px;

  gap:12px;
}

.qty-unit{
  height:54px;

  display:flex;

  align-items:center;

  justify-content:center;

  border-radius:15px;

  border:1px solid var(--border);

  background:
    rgba(255,255,255,.035);

  color:#999faa;

  font-size:12px;

  font-weight:800;
}

.send-button{
  width:100%;

  height:55px;

  margin-top:3px;

  border:0;

  border-radius:16px;

  color:#fff;

  background:
    linear-gradient(
      135deg,
      var(--orange),
      #ff4b00
    );

  box-shadow:
    0 13px 30px
    rgba(255,122,0,.18);

  font-size:13px;

  font-weight:900;

  letter-spacing:.4px;

  transition:.2s;
}

.send-button:hover{
  transform:translateY(-1px);

  box-shadow:
    0 17px 35px
    rgba(255,122,0,.24);
}

.send-button:disabled{
  opacity:.5;

  cursor:not-allowed;

  transform:none;
}

.inventory-message{
  min-height:18px;

  text-align:center;

  margin-top:12px;

  font-size:11px;

  color:#7f8792;
}

.inventory-message.error{
  color:#ff6961;
}

.inventory-message.success{
  color:#50e89a;
}

/* =========================
   SUGGESTIONS
========================= */

.suggestions{
  display:none;

  position:absolute;

  left:0;
  right:0;

  top:82px;

  z-index:50;

  max-height:240px;

  overflow-y:auto;

  padding:5px;

  border-radius:15px;

  background:
    rgba(18,20,25,.98);

  border:
    1px solid var(--border);

  box-shadow:
    0 20px 50px rgba(0,0,0,.5);
}

.suggestion-item{
  padding:10px 11px;

  border-radius:11px;

  cursor:pointer;

  transition:.15s;
}

.suggestion-item:hover{
  background:
    rgba(255,122,0,.10);
}

.suggestion-barcode{
  font-size:12px;

  font-weight:800;

  color:#fff;
}

.suggestion-name{
  margin-top:3px;

  font-size:10px;

  color:#777f8b;

  white-space:nowrap;

  overflow:hidden;

  text-overflow:ellipsis;
}

/* =========================
   HISTORY
========================= */

.history-section{
  margin-top:22px;
}

.history-header{
  display:flex;

  justify-content:space-between;
  align-items:center;

  margin-bottom:10px;
}

.history-header strong{
  font-size:12px;
}

.history-header span{
  color:#646b75;

  font-size:9px;
}

.history-list{
  max-height:180px;

  overflow-y:auto;

  display:flex;

  flex-direction:column;

  gap:7px;
}

.history-item{
  padding:11px 12px;

  border-radius:12px;

  background:
    rgba(255,255,255,.035);

  border:
    1px solid rgba(255,255,255,.055);

  display:flex;

  align-items:center;

  justify-content:space-between;

  gap:12px;
}

.history-left{
  min-width:0;
}

.history-code{
  font-size:11px;

  font-weight:800;
}

.history-name{
  margin-top:3px;

  font-size:9px;

  color:#737b87;

  overflow:hidden;

  white-space:nowrap;

  text-overflow:ellipsis;
}

.history-qty{
  flex:none;

  font-size:11px;

  font-weight:900;

  color:var(--orange2);
}

.history-empty{
  padding:18px;

  text-align:center;

  color:#626975;

  font-size:10px;
}

/* RESET */

.reset-row{
  margin-top:13px;

  display:flex;

  justify-content:flex-end;
}

.reset-button{
  background:none;

  border:0;

  color:#686f7b;

  font-size:10px;

  font-weight:700;
}

.reset-button:hover{
  color:#ff6961;
}

/* =========================
   MODALS
========================= */

.modal{
  position:fixed;

  inset:0;

  z-index:200;

  display:none;

  align-items:center;
  justify-content:center;

  padding:20px;

  background:
    rgba(0,0,0,.72);

  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
}

.modal.show{
  display:flex;
}

.modal-card{
  width:100%;

  max-width:450px;

  max-height:
    calc(100vh - 40px);

  overflow-y:auto;

  padding:26px;

  border-radius:24px;

  background:
    linear-gradient(
      145deg,
      rgba(25,27,32,.98),
      rgba(13,14,18,.98)
    );

  border:1px solid var(--border);

  box-shadow:
    0 30px 100px rgba(0,0,0,.65);

  animation:
    modalIn .25s ease;
}

@keyframes modalIn{
  from{
    opacity:0;
    transform:scale(.96) translateY(10px);
  }

  to{
    opacity:1;
    transform:none;
  }
}

.modal-head{
  display:flex;

  justify-content:space-between;
