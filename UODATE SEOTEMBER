/* =====================================================
   SIGNUP
===================================================== */

window.signup =
async function(){

  const username =
    $("signupUsername")
      .value
      .trim()
      .toLowerCase();

  const email =
    $("signupEmail")
      .value
      .trim()
      .toLowerCase();

  const password =
    $("signupPassword").value;

  const confirm =
    $("signupConfirm").value;

  const message =
    $("signupMessage");


  message.className =
    "message";

  message.textContent =
    "";


  if(
    username.length < 3
  ){

    message.classList.add("error");

    message.textContent =
      "Username minimal 3 karakter.";

    return;

  }


  if(
    !/^[a-z0-9._-]+$/.test(username)
  ){

    message.classList.add("error");

    message.textContent =
      "Username hanya boleh huruf kecil, angka, titik, underscore, dan strip.";

    return;

  }


  if(!email){

    message.classList.add("error");

    message.textContent =
      "Email wajib diisi.";

    return;

  }


  if(password.length < 6){

    message.classList.add("error");

    message.textContent =
      "Password minimal 6 karakter.";

    return;

  }


  if(password !== confirm){

    message.classList.add("error");

    message.textContent =
      "Konfirmasi password tidak sama.";

    return;

  }


  try{

    const usernameRef =
      doc(
        db,
        "usernames",
        username
      );

    const usernameSnap =
      await getDoc(usernameRef);


    if(usernameSnap.exists()){

      message.classList.add("error");

      message.textContent =
        "Username sudah digunakan.";

      return;

    }


    const credential =
      await createUserWithEmailAndPassword(
        auth,
        email,
        password
      );


    const user =
      credential.user;


    await setDoc(
      doc(
        db,
        "users",
        user.uid
      ),
      {

        username,

        email,

        role:"user",

        status:"pending",

        emailVerified:false,

        createdAt:new Date()

      }
    );


    await setDoc(
      usernameRef,
      {
        uid:user.uid
      }
    );


    await sendEmailVerification(user);


    await signOut(auth);


    message.classList.add("success");

    message.textContent =
      "Akun berhasil dibuat. Verifikasi email dan tunggu persetujuan admin.";


    $("signupUsername").value="";
    $("signupEmail").value="";
    $("signupPassword").value="";
    $("signupConfirm").value="";


  }
  catch(error){

    console.error(error);

    message.classList.add("error");

    message.textContent =
      firebaseErrorMessage(error);

  }

};


/* =====================================================
