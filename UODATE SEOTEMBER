/* =====================================================
   WEIGHT BARCODE
===================================================== */

function processWeighedBarcode(
  value
){

  if(
    !value ||
    value.length !== 13 ||
    !/^\d{13}$/.test(value) ||
    !value.startsWith("20")
  ){

    return false;

  }


  /*
    FORMAT:

    20
    XXXXX
    XXXXX
    X

    contoh:

    2012345001250

    20
    12345
    00125
    0
  */


  const productBarcode =
    value.substring(2,7);


  const rawQty =
    value.substring(7,12);


  const grams =
    parseInt(
      rawQty,
      10
    );


  if(!Number.isFinite(grams)){

    return false;

  }


  const qty =
    grams / 1000;


  /*
    Masukkan kode produk
  */

  $("barcode").value =
    productBarcode;


  /*
    Tampilkan qty KG
  */

  let qtyDisplay =
    qty.toFixed(3);


  qtyDisplay =
    qtyDisplay
      .replace(/\.?0+$/,"")
      .replace(".",",");


  $("qty").value =
    qtyDisplay;


  $("suggestions")
    .style
    .display = "none";


  /*
    Cari nama produk
  */

  const product =
    masterData.find(
      item =>
        item.barcode ===
        productBarcode
    );


  if(product){

    showToast(
      product.nama +
      " • " +
      qtyDisplay +
      " KG",
      "success"
    );

  }
  else{

    showToast(
      "Kode " +
      productBarcode +
      " • " +
      qtyDisplay +
      " KG",
      "success"
    );

  }


  return true;

}


/* =====================================================
   QUANTITY NORMALIZATION
===================================================== */

function parseQty(value){

  let text =
    String(value ?? "")
      .trim()
      .replace(/\s/g,"");


  if(!text)
    return NaN;


  /*
    Support:

    1
    1.5
    1,5
    0.125
    0,125
  */


  if(
    text.includes(",") &&
    text.includes(".")
  ){

    /*
      Jika format 1.234,56
    */

    if(
      text.lastIndexOf(",") >
      text.lastIndexOf(".")
    ){

      text =
        text
          .replace(/\./g,"")
          .replace(",", ".");

    }
    else{

      text =
        text.replace(/,/g,"");

    }

  }
  else if(
    text.includes(",")
  ){

    text =
      text.replace(",", ".");

  }


  const number =
    Number(text);


  return number;

}


