async function loadPendingUsers(){

  const list =
    $("pendingList");


  list.innerHTML =
    `
      <div class="history-empty">
        Loading...
      </div>
    `;


  try{

    const q =
      query(
        collection(
          db,
          "users"
        ),
        where(
          "status",
          "==",
          "pending"
        )
      );


    const snapshot =
      await getDocs(q);


    if(snapshot.empty){

      list.innerHTML =
        `
          <div class="history-empty">
            Tidak ada user pending
          </div>
        `;

      return;

    }


    list.innerHTML = "";


    snapshot.forEach(
      userDoc => {

        const data =
          userDoc.data();


        const div =
          document.createElement("div");


        div.className =
          "pending-user";


        div.innerHTML = `

          <div class="pending-user-top">

            <div>

              <div class="pending-user-name">
                ${escapeHtml(
                  data.username || "-"
                )}
              </div>

              <div class="pending-user-email">
                ${escapeHtml(
                  data.email || "-"
                )}
              </div>

            </div>

          </div>

          <div class="pending-actions">

            <button
              class="small-btn approve-btn"
              data-uid="${userDoc.id}"
              data-action="approve"
            >
              APPROVE
            </button>

            <button
              class="small-btn reject-btn"
              data-uid="${userDoc.id}"
              data-action="reject"
            >
              REJECT
            </button>

          </div>
        `;


        list.appendChild(div);

      }
    );


    list
      .querySelectorAll(
        ".small-btn"
      )
      .forEach(button => {

        button.addEventListener(
          "click",
          async () => {

            await updateUserStatus(
              button.dataset.uid,
