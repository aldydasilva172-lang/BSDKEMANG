===================================================== */

async function loadHistory(){

  const list =
    $("historyList");


  list.innerHTML =
    `
      <div class="history-empty">
        Loading...
      </div>
    `;


  try{

    const response =
      await fetch(
        URL_SCRIPT,
        {

          method:"POST",

          body:
            JSON.stringify({

              action:
                "getHistory",

              mode:
                currentMode

            })

        }
      );


    const data =
      await response.json();


    let rows = [];


    if(Array.isArray(data)){

      rows = data;

    }
    else if(
      Array.isArray(data.data)
    ){

      rows =
        data.data;

    }


    if(!rows.length){

      list.innerHTML =
        `
          <div class="history-empty">
            Belum ada data
          </div>
        `;

      return;

    }


    /*
      Ambil maksimal 30 history
    */

    rows =
      rows
        .slice(-30)
        .reverse();


    list.innerHTML =
      rows
        .map(item => {

          const barcode =
            item.barcode ??
            item.kode ??
            item.article ??
            "-";


          const qty =
            item.qty ??
            item.quantity ??
            item.Qty ??
            "-";


          const name =
            item.nama ??
            item.name ??
            "";


          return `

            <div class="history-item">

              <div class="history-left">

                <div class="history-code">
                  ${escapeHtml(
                    barcode
                  )}
                </div>

                <div class="history-name">
                  ${escapeHtml(
                    name
                  )}
                </div>

              </div>

              <div class="history-qty">
                ${escapeHtml(
                  String(qty)
                )} KG
              </div>

            </div>

          `;

        })
        .join("");


  }
  catch(error){

    console.error(
      "History error:",
      error
    );


    list.innerHTML =
      `
        <div class="history-empty">
          Riwayat belum tersedia
        </div>
      `;

  }

}


