0 0 20px rgba(124,58,237,.5),
0 2px 8px rgba(0,0,0,.8);
}

.history-header{
display:flex;

background:rgba(249,115,22,.20);

border:1px solid rgba(249,115,22,.35);

border-radius:10px 10px 0 0;

