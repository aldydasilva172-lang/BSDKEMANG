opacity:0;
transform:translateY(-5px);
}
to{
opacity:1;
transform:translateY(0);
}
}

.history-nama{
flex:1;

padding:8px 10px;

font-size:13px;
font-weight:600;

color:white;

text-align:left;

border-right:1px solid rgba(255,255,255,.10);

text-shadow:
