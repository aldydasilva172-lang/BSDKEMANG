letter-spacing:.5px;
}

/* LAST INPUT */

.last-input-box{
display:none;

margin-top:16px;
margin-bottom:8px;

border:1px solid rgba(255,255,255,.08);

background:rgba(0,0,0,.02);

border-radius:22px;

padding:10px 12px;

backdrop-filter:blur(2px);
-webkit-backdrop-filter:blur(2px);

box-shadow:
0 0 14px rgba(0,245,255,.18),
0 0 28px rgba(124,58,237,.25),
