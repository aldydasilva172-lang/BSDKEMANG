padding:8px 10px;

text-align:center;

font-size:12px;
font-weight:700;

color:#f97316;

background:transparent;

text-shadow:
0 0 6px rgba(249,115,22,.35);
}

/* INPUT BOX */

.input-box{
margin-bottom:16px;
