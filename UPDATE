overflow:visible;
}

.barcode-box{
z-index:9999;
}

.qty-box{
z-index:1;
}

.input-box label{
display:block;

margin-bottom:8px;

font-size:14px;
font-weight:600;

color:white;

text-shadow:
0 2px 8px rgba(0,0,0,.7),
0 0 8px rgba(0,245,255,.35);

letter-spacing:.5px;
}

.input-box input{
width:100%;

padding:16px;

border:none;
outline:none;

border-radius:16px;

border:1px solid rgba(255,255,255,.08);

background:rgba(0,0,0,.25);

color:white;

font-size:15px;
font-weight:500;

backdrop-filter:blur(6px);

transition:.3s;

box-shadow:
0 4px 12px rgba(0,0,0,.25);
}

.input-box input:focus{
border:1px solid rgba(0,245,255,.7);

background:rgba(0,0,0,.35);

box-shadow:
0 0 12px rgba(0,245,255,.35),
0 0 25px rgba(124,58,237,.20),
0 4px 15px rgba(0,0,0,.35);

transform:scale(1.01);
}

input::placeholder{
color:rgba(219,234,254,.55);

text-shadow:
0 0 6px rgba(0,245,255,.18);

letter-spacing:.4px;
}

/* ============================= */
/* BUTTON GLASS NEON */
/* ============================= */

button{

width:100%;
padding:16px;

border:none;
border-radius:18px;

background:
linear-gradient(
135deg,
rgba(0,0,0,.72),
rgba(5,15,25,.62)
);

color:white;

font-size:16px;
font-weight:600;

cursor:pointer;

transition:
transform .25s ease,
box-shadow .25s ease,
border-color .25s ease,
background .25s ease;

border:1px solid rgba(0,245,255,.35);

backdrop-filter:blur(10px);
-webkit-backdrop-filter:blur(10px);

box-shadow:
inset 0 0 15px rgba(0,245,255,.08),
0 0 10px rgba(0,245,255,.18),
0 0 25px rgba(0,245,255,.10),
0 10px 25px rgba(0,0,0,.45);

text-shadow:
0 0 8px rgba(255,255,255,.45),
0 2px 8px rgba(0,0,0,.8);

letter-spacing:.5px;

position:relative;

overflow:hidden;
}


/* CAHAYA DI DALAM TOMBOL */

button::before{

content:"";

position:absolute;

top:0;
left:-120%;

width:70%;
height:100%;

background:
linear-gradient(
90deg,
transparent,
rgba(255,255,255,.12),
transparent
);

transform:skewX(-20deg);

transition:.5s;

}


/* HOVER */

button:hover{

transform:
translateY(-2px)
scale(1.01);

border-color:
rgba(0,245,255,.75);

background:
linear-gradient(
135deg,
rgba(0,0,0,.80),
rgba(5,20,30,.72)
);

box-shadow:
inset 0 0 20px rgba(0,245,255,.12),
0 0 15px rgba(0,245,255,.45),
0 0 35px rgba(0,245,255,.25),
0 12px 30px rgba(0,0,0,.50);

}

button:hover::before{

left:130%;

}


/* SAAT DITEKAN */

button:active{

transform:
scale(.98);

box-shadow:
inset 0 0 25px rgba(0,245,255,.18),
0 0 20px rgba(0,245,255,.55);

}


/* DISABLED */

button:disabled{

opacity:.6;

cursor:not-allowed;

filter:none;

}


/* ============================= */
/* RESET BUTTON */
/* ============================= */

.reset-btn{

margin-top:12px;

border-color:
rgba(255,60,60,.35);

background:
linear-gradient(
135deg,
rgba(0,0,0,.74),
rgba(25,5,8,.65)
);

box-shadow:
inset 0 0 15px rgba(255,0,0,.07),
0 0 10px rgba(255,0,0,.18),
0 0 25px rgba(255,0,0,.10),
0 10px 25px rgba(0,0,0,.45);

}


/* RESET HOVER */

.reset-btn:hover{

border-color:
rgba(255,70,70,.80);

background:
linear-gradient(
135deg,
rgba(0,0,0,.82),
rgba(30,5,8,.72)
);

box-shadow:
inset 0 0 20px rgba(255,0,0,.12),
0 0 15px rgba(255,50,50,.45),
0 0 35px rgba(255,0,0,.25),
0 12px 30px rgba(0,0,0,.50);

}


/* RESET ACTIVE */

.reset-btn:active{

box-shadow:
inset 0 0 25px rgba(255,0,0,.18),
0 0 20px rgba(255,50,50,.55);

}

/* STATUS */

#status{
margin-top:16px;

text-align:center;

font-size:14px;

font-weight:500;

color:rgba(225,225,225,.95);

min-height:20px;

text-shadow:
0 2px 8px rgba(255,255,255,.35),
0 0 12px rgba(0,245,255,.45),
0 0 22px rgba(0,245,255,.25);

letter-spacing:.3px;
}

/* NAMA BARANG */

#namaBarang{
margin-top:10px;

padding:12px 14px;

border-radius:14px;

background:rgba(255,255,255,.06);

border:1px solid rgba(255,255,255,.08);

color:white;

font-size:14px;
font-weight:500;

text-align:center;

text-shadow:
0 0 10px rgba(0,245,255,.7),
0 0 20px rgba(124,58,237,.5),
0 2px 8px rgba(0,0,0,.8);

box-shadow:
0 0 12px rgba(0,245,255,.10);

min-height:20px;

display:none;
}

/* DROPDOWN */

#suggestions{
position:absolute;

top:calc(100% + 8px);

left:0;
right:0;

max-height:320px;

overflow-y:auto;

overscroll-behavior:contain;

z-index:9999999;

display:none;

background:
linear-gradient(
rgba(0,0,0,.75),
rgba(0,0,0,.75)
),
url('232c59a2-a76c-4766-8c58-20a6e1b7550a.jpeg')
center center / cover no-repeat;

backdrop-filter:blur(8px);

border-radius:18px;

border:1px solid rgba(255,255,255,.08);

box-shadow:
0 10px 25px rgba(0,0,0,.35);

-webkit-overflow-scrolling:touch;

transform:translateZ(999px);
}

.suggest-item{
padding:12px 20px;

border-bottom:1px solid rgba(255,255,255,.05);

cursor:pointer;

transition:.2s;

display:flex;
flex-direction:column;

align-items:center;
justify-content:center;

text-align:center;
}

.suggest-item:last-child{
border-bottom:none;
}

.suggest-item:hover{
background:rgba(255,255,255,.08);
}

.suggest-barcode{
font-size:14px;
font-weight:700;

color:#00f5ff;
}

.suggest-name{
font-size:13px;

color:#cbd5e1;

margin-top:4px;

line-height:1.4;
}

/* MODAL */

.modal{
position:fixed;
inset:0;

display:none;

align-items:center;
justify-content:center;

background:rgba(0,0,0,.72);

backdrop-filter:blur(10px);
-webkit-backdrop-filter:blur(10px);

z-index:999999999;

padding:20px;

overflow:auto;
}

/* MODAL BOX */

.modal-box{
width:90%;
max-width:360px;

padding:28px;

border-radius:28px;

background:
linear-gradient(
rgba(0,0,0,.45),
rgba(0,0,0,.45)
),
url('232c59a2-a76c-4766-8c58-20a6e1b7550a.jpeg')
center center / cover no-repeat;

border:1px solid rgba(255,255,255,.08);

backdrop-filter:blur(10px);
-webkit-backdrop-filter:blur(10px);

box-shadow:
0 0 15px rgba(0,245,255,.25),
0 0 35px rgba(124,58,237,.20),
0 15px 35px rgba(0,0,0,.45);

animation:popup .25s ease;

overflow:hidden;

position:relative;
}

@keyframes popup{
from{
transform:scale(.85);
opacity:0;
}
to{
transform:scale(1);
opacity:1;
}
}

.modal-title{
text-align:center;

font-size:22px;
font-weight:700;

color:white;

margin-bottom:20px;

text-shadow:
0 0 10px rgba(0,245,255,.45),
0 2px 8px rgba(0,0,0,.8);
}

.modal-input{
width:100%;

padding:16px;

border:none;
outline:none;

border-radius:18px;

background:rgba(0,0,0,.35);

color:white;

font-size:16px;

border:1px solid rgba(255,255,255,.08);

margin-bottom:18px;

transition:.3s;
}

.modal-input:focus{
border:1px solid rgba(0,245,255,.7);

box-shadow:
0 0 12px rgba(0,245,255,.35),
0 0 25px rgba(124,58,237,.20);

background:rgba(0,0,0,.45);
}

.modal-actions{
display:flex;

gap:12px;
}

.modal-actions button{
flex:1;

padding:14px;

border-radius:16px;
}

.cancel-btn{
background:rgba(255,255,255,.08);
}

.confirm-btn{
background:
linear-gradient(
135deg,
#00f5ff,
#7c3aed
);
}

@media(max-width:500px){

.container{
padding:28px;
}

h1{
font-size:24px;
}

#suggestions{
max-height:280px;
}

}

@supports (-webkit-touch-callout: none){

html{
height:-webkit-fill-available;
}

body{
min-height:-webkit-fill-available;
}

}

@media (min-width:768px){

body{
display:flex;

justify-content:center;
