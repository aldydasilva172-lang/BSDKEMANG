<div id="namaBarang"></div>

<div id="suggestions"></div>

</div>


<!-- QTY -->

<div class="input-box qty-box">

<label>Qty</label>

<input 
type="text"
inputmode="decimal"
id="qty" 
placeholder="Masukkan Qty"
>

</div>


<button id="btnKirim" onclick="kirimData()">
Kirim Data
</button>

<button onclick="resetData()" class="reset-btn">
Reset Data Stockloss
</button>

<div id="status"></div>


<!-- HISTORY -->

<div id="historyBox" class="last-input-box">

<div class="last-title">
DATA INPUT
</div>

<div class="history-header">

<div>
ARTICLE NAME
</div>

<div>
QTY
</div>

</div>

<div id="historyList"></div>

</div>

</div>


<!-- MODAL PASSWORD -->

<div class="modal" id="passwordModal">

<div class="modal-box">

<div class="modal-title">
Silahkan Masukan Password
</div>

<input
type="password"
id="adminPassword"
class="modal-input"
placeholder="Masukkan password"
>

<div class="modal-actions">

<button
class="cancel-btn"
onclick="closePasswordModal()">
Batal
</button>

<button
class="confirm-btn"
onclick="submitReset()">
Masuk
</button>

</div>

</div>

</div>


<script>

/* ================================================= */
/* CONFIG */
/* ================================================= */

const URL_SCRIPT =
"https://script.google.com/macros/s/AKfycbyYp-CRc2wUKF-OQ8VFb3NApejjOSpIDbdlVxcsvgDtY8YHEwGdysxaHU1ruQATXOIS-w/exec";

const ADMIN_PASSWORD = "0800";

let currentMode = "";

let barcodeCache = [];

let debounceTimer;

let historyData = [];



/* ================================================= */
/* RENDER HISTORY */
/* ================================================= */

function renderHistory(){

const box =
document.getElementById(
"historyBox"
);

const list =
document.getElementById(
"historyList"
);


if(
!Array.isArray(historyData) ||
historyData.length === 0
){

box.style.display = "none";

list.innerHTML = "";

return;

}


box.style.display = "block";


let html = "";


historyData
.slice(0,50)
.forEach(item=>{

html += `

<div class="history-item">

<div class="history-nama">
${escapeHTML(item.nama)}
</div>

<div class="history-qty">
${escapeHTML(item.qty)}
</div>

</div>

`;

});


list.innerHTML = html;

}


/* ================================================= */
/* ESCAPE HTML */
/* ================================================= */

function escapeHTML(value){

return String(value ?? "")
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


/* ================================================= */
/* TAMBAH HISTORY LANGSUNG */
/* ================================================= */

function addHistoryInstant(nama,qty){

historyData.unshift({

nama:nama || "-",

qty:qty

});


historyData =
historyData.slice(0,50);

renderHistory();

}


/* ================================================= */
/* LOAD BARCODE DARI MASTER */
/* ================================================= */

async function loadBarcodeData(){

try{

const res =
await fetch(URL_SCRIPT,{

method:"POST",

headers:{
"Content-Type":
"text/plain;charset=utf-8"
},

body:JSON.stringify({
action:"getAllBarcode"
})

});

barcodeCache =
await res.json();

console.log(
"Barcode berhasil dimuat:",
barcodeCache.length
);

}catch(err){

console.log(
"Load barcode error:",
err
);

barcodeCache = [];

}

}

/* ================================================= */
/* AUTO FOCUS / INITIAL LOAD */
/* ================================================= */

window.onload = async () => {

await loadBarcodeData();

setTimeout(()=>{

document
.getElementById("loginPassword")
.focus();

},200);

};


/* ================================================= */
/* ================================================= */
/* LOGIN */
/* ================================================= */

function loginApp(){

const password =
document
.getElementById("loginPassword")
.value;


if(password !== ADMIN_PASSWORD){

const status = document.getElementById("loginStatus");

status.innerHTML = "❌ Password salah";

status.style.color = "#ff4d4d";

return;

}


/* PASSWORD BENAR */

document
.getElementById("loginOverlay")
.style.display =
"none";


/* TAMPILKAN PILIH MODE */

document
.getElementById("modeOverlay")
.style.display =
"flex";

}


/* ================================================= */
/* PILIH MODE */
/* ================================================= */

function pilihMode(mode){

currentMode = mode;

const title =
document.querySelector("h1");

const desc =
document.querySelector(".desc");

const modeOverlay =
document.getElementById("modeOverlay");


if(mode === "stockloss"){

title.innerText =
"STOCKLOSS BSD";

desc.innerText =
"Scan / Input Barcode dan Qty";

document.querySelector(".reset-btn").innerText =
"Reset Data Stockloss";

}

else if(mode === "opname"){

title.innerText =
"STOCK OPNAME BSD";

desc.innerText =
"Scan / Input Barcode dan Qty";

document.querySelector(".reset-btn").innerText =
"Reset Data Stock Opname";

}


/* KOSONGKAN HISTORY MODE SEBELUMNYA */

historyData = [];

renderHistory();


modeOverlay.style.display =
"none";


/* LOAD HISTORY SESUAI MODE */

loadHistory();


setTimeout(()=>{

document
.getElementById("barcode")
.focus();

},100);

}


/* ================================================= */
/* ENTER LOGIN */
/* ================================================= */

document
.getElementById("loginPassword")
.addEventListener(
"keypress",
function(e){

if(e.key === "Enter"){

loginApp();

}

});


/* ================================================= */
/* LOAD History */
/* ================================================= */

async function loadHistory(){

try{

const res =
await fetch(URL_SCRIPT,{

method:"POST",

headers:{
"Content-Type":
"text/plain;charset=utf-8"
},

body:JSON.stringify({
action:"getHistory",
mode:currentMode
})

});

historyData =
await res.json();

renderHistory();

}catch(err){

console.log(
"Load history error:",
err
);

}

}


/* ================================================= */
/* HIDE DROPDOWN */
/* ================================================= */

function hideSuggestions(){

const suggestions =
document.getElementById("suggestions");

suggestions.innerHTML = "";

suggestions.style.display = "none";

}


/* ================================================= */
/* AUTO QTY + NAMA */
/* ================================================= */

document
.getElementById("barcode")
.addEventListener(
"input",
function(){

const barcode =
this.value.trim();


tampilkanNamaBarang(
barcode
);


if(
barcode.startsWith("20") &&
barcode.length === 13 &&
/^\d+$/.test(barcode)
){

hideSuggestions();


const qtyRaw =
barcode.substring(7,12);


const qtyNumber =
parseInt(
qtyRaw,
10
) / 1000;


let qtyFormatted =
qtyNumber
.toFixed(3)
.replace(/\.?0+$/,'');


qtyFormatted =
qtyFormatted.replace(
".",
","
);


document
.getElementById("qty")
.value =
qtyFormatted;

}

});


/* ================================================= */
/* TAMPILKAN NAMA BARANG */
/* ================================================= */

function tampilkanNamaBarang(barcode){

const namaBox =
document.getElementById(
"namaBarang"
);


let searchBarcode =
barcode;


/* BARCODE TIMBANG */

if(
barcode.startsWith("20") &&
barcode.length === 13 &&
/^\d+$/.test(barcode)
){

searchBarcode =
barcode.substring(2,7);

}


const item =
barcodeCache.find(x =>
String(x.barcode) ===
String(searchBarcode)
);


if(item){

namaBox.style.display =
"block";

namaBox.innerHTML =
escapeHTML(item.nama);

}else{

namaBox.style.display =
"none";

namaBox.innerHTML = "";

}

}


/* ================================================= */
/* AUTOCOMPLETE */
/* ================================================= */

document
.getElementById("barcode")
.addEventListener(
"input",
function(e){

e.stopPropagation();


clearTimeout(
debounceTimer
);


debounceTimer =
setTimeout(()=>{

const keyword =
this.value
.trim()
.toLowerCase();


const suggestions =
document.getElementById(
"suggestions"
);


if(keyword.length < 2){

suggestions.innerHTML = "";
suggestions.style.display = "none";

return;

}


let filtered =
barcodeCache.filter(item=>{

const barcode =
String(item.barcode)
.toLowerCase();

const nama =
String(item.nama)
.toLowerCase();


return(
barcode.startsWith(keyword) ||
barcode.includes(keyword) ||
nama.includes(keyword)
);

});


filtered =
filtered.slice(0,20);


let html = "";


filtered.forEach(item=>{

html += `

<div
class="suggest-item"
onclick="pilihBarcode('${String(item.barcode).replace(/'/g,"\\'")}')">

<div class="suggest-barcode">
${escapeHTML(item.barcode)}
</div>

<div class="suggest-name">
${escapeHTML(item.nama)}
</div>

</div>

`;

});


suggestions.innerHTML =
html;

if(filtered.length > 0){

suggestions.style.display = "block";

}else{

suggestions.style.display = "none";

}

},120);

});


/* ================================================= */
/* HIDE QTY DROPDOWN */
/* ================================================= */

document
.getElementById("qty")
.addEventListener(
"focus",
function(){

hideSuggestions();

});


/* ================================================= */
/* HIDE CLICK LUAR */
/* ================================================= */

document.addEventListener(
"click",
function(e){

if(
!e.target.closest(
".input-box"
)
){

hideSuggestions();

}

});


/* ================================================= */
/* PILIH BARCODE */
/* ================================================= */

function pilihBarcode(barcode){

document
.getElementById("barcode")
.value =
barcode;


tampilkanNamaBarang(
barcode
);


hideSuggestions();


document
.getElementById("qty")
.focus();

}


/* ================================================= */
/* ENTER BARCODE */
/* ================================================= */

document
.getElementById("barcode")
.addEventListener(
"keypress",
function(e){

if(e.key === "Enter"){

e.preventDefault();

hideSuggestions();

document
.getElementById("qty")
.focus();

}

});


/* ================================================= */
/* ENTER QTY */
/* ================================================= */

document
.getElementById("qty")
.addEventListener(
"keypress",
function(e){

if(e.key === "Enter"){

e.preventDefault();

hideSuggestions();

kirimData();

}

});


/* ================================================= */
/* KIRIM DATA - OPTIMIZED */
/* ================================================= */

async function kirimData(){

const barcodeInput =
document
.getElementById("barcode");


const qtyInput =
document
.getElementById("qty");


let barcode =
barcodeInput.value.trim();


let qty =
qtyInput.value.trim();


if(
barcode === "" ||
qty === ""
){

document
.getElementById("status")
.innerHTML =
"⚠️ Barcode dan Qty wajib diisi";

return;

}


let namaBarang = "";

let searchBarcode =
barcode;


/* BARCODE TIMBANG */

if(
barcode.startsWith("20") &&
barcode.length === 13 &&
/^\d+$/.test(barcode)
){

searchBarcode =
barcode.substring(2,7);

}


const item =
barcodeCache.find(x =>
String(x.barcode) ===
String(searchBarcode)
);


if(item){

namaBarang =
item.nama;

}


/* QTY */

qty =
qty.replace(",", ".");


const btn =
document
.getElementById("btnKirim");


btn.disabled = true;

btn.innerHTML =
"⏳ Mengirim...";


/* ================================================= */
/* SIMPAN DATA INPUT */
/* ================================================= */

barcodeInput.value = "";

qtyInput.value = "";

document
.getElementById("namaBarang")
.style.display =
"none";

document
.getElementById("namaBarang")
.innerHTML = "";

hideSuggestions();


/* ================================================= */
/* UPDATE HISTORY LANGSUNG */
/* ================================================= */

addHistoryInstant(
namaBarang || barcode,
qty
);


document
.getElementById("status")
.innerHTML =
"⏳ Menyimpan data...";


barcodeInput.focus();


/* ================================================= */
/* KIRIM KE GOOGLE */
/* ================================================= */

try{

const res =
await fetch(
URL_SCRIPT,
{

method:"POST",

headers:{
"Content-Type":
"text/plain;charset=utf-8"
},

body:JSON.stringify({

action:"saveData",

barcode:barcode,

qty:qty,

mode:currentMode

})

});


const result =
await res.text();


if(
result.startsWith("Success")
){

document
.getElementById("status")
.innerHTML =
"✅ Data berhasil dikirim";

}else{

throw new Error(result);

}


}catch(err){

console.log(
"Send error:",
err
);


/*
 * Jika gagal, hapus history
 * yang tadi ditampilkan secara lokal.
 */

historyData.shift();

renderHistory();


document
.getElementById("status")
.innerHTML =
"❌ Gagal mengirim data";


}finally{

btn.disabled = false;

btn.innerHTML =
"Kirim Data";

}

}


/* ================================================= */
/* BUKA MODAL PASSWORD */
/* ================================================= */

function openPasswordModal(){

document
.getElementById("passwordModal")
.style.display =
"flex";


document
.getElementById("adminPassword")
.value = "";


setTimeout(()=>{

document
.getElementById("adminPassword")
.focus();

},100);

}


/* ================================================= */
/* TUTUP MODAL */
/* ================================================= */

function closePasswordModal(){

document
.getElementById("passwordModal")
.style.display =
"none";


document
.getElementById("adminPassword")
.value = "";

}


/* ================================================= */
/* ENTER PASSWORD RESET */
/* ================================================= */

document.addEventListener(
"keydown",
function(e){

const modal =
document.getElementById(
"passwordModal"
);


if(
modal.style.display ===
"flex"
){

if(e.key === "Enter"){

e.preventDefault();

submitReset();

}


if(e.key === "Escape"){

closePasswordModal();

}

}

});


/* ================================================= */
/* RESET */
/* ================================================= */

function resetData(){

openPasswordModal();

}


/* ================================================= */
/* SUBMIT RESET - OPTIMIZED */
/* ================================================= */

async function submitReset(){

const password =
document
.getElementById("adminPassword")
.value;


if(password !== ADMIN_PASSWORD){

document
.getElementById("status")
.innerHTML =
"❌ Password salah";

return;

}


closePasswordModal();


const namaMode =
currentMode === "opname"
? "STOCK OPNAME"
: "STOCKLOSS";

const konfirmasi =
confirm(
`Yakin ingin menghapus semua data ${namaMode} sebelumnya?`
);


if(!konfirmasi){

return;

}


/* ================================================= */
/* LANGSUNG KOSONGKAN HISTORY */
/* ================================================= */

historyData = [];

renderHistory();


document
.getElementById("barcode")
.value = "";

document
.getElementById("qty")
.value = "";

document
.getElementById("namaBarang")
.style.display =
"none";

document
.getElementById("namaBarang")
.innerHTML = "";

hideSuggestions();


document
.getElementById("status")
.innerHTML =
"⏳ Menghapus data...";


const resetButton =
document.querySelector(
".reset-btn"
);


resetButton.disabled =
true;


try{

const res =
await fetch(
URL_SCRIPT,
{

method:"POST",

headers:{
"Content-Type":
"text/plain;charset=utf-8"
},

body:JSON.stringify({

action:"reset",

password:password,

mode:currentMode

})

});


const result =
await res.text();


if(
result ===
"Reset berhasil"
){

document
.getElementById("status")
.innerHTML =
`✅ Semua data ${namaMode} sebelumnya berhasil dihapus`;


}else{

throw new Error(result);

}


}catch(err){

console.log(
"Reset error:",
err
);


document
.getElementById("status")
.innerHTML =
"❌ Gagal reset data";


/*
 * Jika reset gagal,
 * ambil kembali history asli.
 */

await loadHistory();


}finally{

resetButton.disabled =
false;


document
.getElementById("barcode")
.focus();

}

}

</script>

</body>
</html>
